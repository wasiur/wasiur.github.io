%% cvstyle.sty -- shared layout for the CV and the list of publications.
%% Typography and colours match www.wasiur.xyz: Source Serif 4 / Source Sans 3, maroon accent.
%% Requires LuaLaTeX or XeLaTeX (fontspec).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cvstyle}[2026/10/08 CV and publication list layout]

\RequirePackage[a4paper,top=2.2cm,bottom=2.6cm,left=2.4cm,right=2.4cm]{geometry}

% ---------------------------------------------------------------- fonts
\RequirePackage{fontspec}
\setmainfont{SourceSerif4}[
  Extension      = .otf,
  UprightFont    = *-Regular,
  ItalicFont     = *-RegularIt,
  BoldFont       = *-Semibold,
  BoldItalicFont = *-SemiboldIt,
  Numbers        = OldStyle]
\setsansfont{SourceSans3}[
  Extension      = .otf,
  UprightFont    = *-Regular,
  ItalicFont     = *-RegularIt,
  BoldFont       = *-Semibold,
  BoldItalicFont = *-SemiboldIt]
\RequirePackage{microtype}

% ---------------------------------------------------------------- colours
\RequirePackage{xcolor}
\definecolor{accent}{HTML}{7A1F2B}
\definecolor{muted}{HTML}{6E6A65}
\definecolor{hairline}{HTML}{D9D3CB}

% ---------------------------------------------------------------- headings
\RequirePackage{titlesec}
\RequirePackage{needspace}
\titleformat{\section}
  {\needspace{7\baselineskip}\normalfont\Large\scshape\color{accent}}{}{0pt}{\lsstyle}
  [{\color{hairline}\vspace{2pt}\titlerule[0.4pt]}]
\titlespacing*{\section}{0pt}{20pt}{10pt}
\titleformat{\subsection}{\needspace{4\baselineskip}\normalfont\itshape}{}{0pt}{}
\titlespacing*{\subsection}{0pt}{10pt}{5pt}

% ---------------------------------------------------------------- lists
\RequirePackage{enumitem}
\setlist{itemsep=2pt, topsep=2pt, parsep=0pt}
\setlist[itemize]{label={\textcolor{muted}{\small\textbullet}}, leftmargin=1.2em}
\RequirePackage{multicol}

% ---------------------------------------------------------------- page style
% \cvdoctype names the document in the footer; redefine it per document.
\newcommand{\cvdoctype}{Curriculum vitae}
\RequirePackage{lastpage}
\RequirePackage{fancyhdr}
\newcommand{\cvmonth}{\ifcase\month\or January\or February\or March\or April\or May\or June\or
  July\or August\or September\or October\or November\or December\fi}
\newcommand{\cvfootright}{\sffamily\footnotesize\color{muted}\cvmonth\ \the\year\ \textperiodcentered\ Page \thepage\ of \pageref{LastPage}}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[L]{\sffamily\footnotesize\color{muted}Wasiur R. KhudaBukhsh \textperiodcentered\ \cvdoctype}
\fancyfoot[R]{\cvfootright}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[R]{\cvfootright}}

% ---------------------------------------------------------------- links & metadata
\RequirePackage[hidelinks]{hyperref}
\hypersetup{
  pdfauthor  = {Wasiur R. KhudaBukhsh},
  pdfkeywords= {probability, stochastic processes, mathematical biology},
  colorlinks, linkcolor=accent, urlcolor=accent, citecolor=accent}
\urlstyle{same}

% ---------------------------------------------------------------- header
% \cvheader{subtitle}: name, subtitle, contact details and a hairline.
\newcommand{\cvheader}[1]{%
  {\fontsize{26}{30}\selectfont Wasiur R. KhudaBukhsh\par}
  \vspace{5pt}
  {\large\itshape\color{muted}#1\par}
  \vspace{9pt}
  {\sffamily\small\color{muted}%
    School of Mathematical Sciences, University of Nottingham, University Park, Nottingham NG7 2RD, UK\\[1pt]
    \href{mailto:wasiur.khudabukhsh@nottingham.ac.uk}{wasiur.khudabukhsh@nottingham.ac.uk}
    \ \textperiodcentered\ \href{https://www.wasiur.xyz/}{www.wasiur.xyz}
    \ \textperiodcentered\ ORCID \href{https://orcid.org/0000-0003-1803-0470}{0000-0003-1803-0470}\par}
  \vspace{6pt}
  {\color{hairline}\rule{\linewidth}{0.4pt}}\par}

% ---------------------------------------------------------------- CV entries
% A date column on the left, the entry on the right.
\newlength{\datewidth}
\setlength{\datewidth}{3.35cm}
\newcommand{\datefont}{\sffamily\small\color{muted}}
\newcommand{\cvitem}[2]{%
  \par\noindent
  \begin{minipage}[t]{\datewidth}\leavevmode\raggedright\datefont #1\end{minipage}%
  \begin{minipage}[t]{\dimexpr\linewidth-\datewidth\relax}\leavevmode\raggedright #2\end{minipage}%
  \par\vspace{3.5pt}}
% \cventry[detail]{dates}{title}{place}
\newcommand{\cventry}[4][]{%
  \cvitem{#2}{\textbf{#3}\\#4%
    \if\relax\detokenize{#1}\relax\else\\{\small\color{muted}#1}\fi}}
% Short note under a section heading.
\newcommand{\cvnote}[1]{\par\noindent{\small\color{muted}#1}\par\vspace{6pt}}

% ---------------------------------------------------------------- publications
\RequirePackage[numbers,sort]{natbib}
\RequirePackage{bibtopic}
% Bibliography as a plain numbered list without a "References" heading;
% numbering continues across the publication sections.
\renewcommand{\bibsection}{}
\renewcommand{\bibnumfmt}[1]{{\sffamily\small\color{muted}#1.}}
\setlength{\bibsep}{3pt}

% Never hyphenate the surname.
\hyphenation{KhudaBukhsh}

\setlength{\parindent}{0pt}
\raggedbottom

\endinput
